{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/harnessimo-brief.sh",
            "timeout": 10,
            "statusMessage": "Loading harness state…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/harnessimo-gate.sh",
            "timeout": 120,
            "statusMessage": "Running the harness gates…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/harnessimo-gate.sh",
            "timeout": 120,
            "statusMessage": "Running the harness gates…"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install harnessimo hook task-completed",
            "timeout": 180,
            "statusMessage": "Running the harness gates before the task closes…"
          }
        ]
      }
    ]
  }
}
