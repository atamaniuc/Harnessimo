{
  "name": "harnessimo",
  "version": "0.5.3",
  "description": "Eight checks that stop an AI coding agent from calling unfinished work done: proof markers over documentation, a re-verified work queue, work tracks and handoffs, locked scoring surfaces and a cold-start test. Zero dependencies, no build step, any language.",
  "keywords": [
    "harness",
    "ai-agents",
    "agentic-coding",
    "spec-driven-development",
    "handoff-driven-development",
    "claude-code",
    "ci"
  ],
  "license": "MIT",
  "author": "atamaniuc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atamaniuc/Harnessimo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harnessimo": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "default": "./dist/proof.js"
    },
    "./tracks": {
      "types": "./dist/tracks.d.ts",
      "default": "./dist/tracks.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "default": "./dist/readiness.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node --test test/*.test.ts && node src/cli.ts check",
    "docs:sync": "node scripts/site-home.ts",
    "demo": "node scripts/record-demo.ts",
    "harnessimo": "node src/cli.ts"
  },
  "homepage": "https://atamaniuc.github.io/Harnessimo/",
  "bugs": {
    "url": "https://github.com/atamaniuc/Harnessimo/issues"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
