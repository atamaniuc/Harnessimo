{
  "name": "harnessimo",
  "version": "0.3.0",
  "description": "Eight checks that stop an AI coding agent from calling unfinished work done: proof markers over documentation, a re-verified work queue, work tracks and handoffs, locked scoring surfaces and a cold-start test. Zero dependencies, no build step, any language.",
  "keywords": [
    "harness",
    "ai-agents",
    "agentic-coding",
    "spec-driven-development",
    "handoff-driven-development",
    "claude-code",
    "ci"
  ],
  "license": "MIT",
  "author": "atamaniuc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atamaniuc/Harnessimo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harnessimo": "bin/harnessimo.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./proof": {
      "types": "./types/index.d.ts",
      "default": "./src/proof.mjs"
    },
    "./tracks": {
      "types": "./types/index.d.ts",
      "default": "./src/tracks.mjs"
    },
    "./tasks": {
      "types": "./types/index.d.ts",
      "default": "./src/tasks.mjs"
    },
    "./queue": {
      "types": "./types/index.d.ts",
      "default": "./src/queue.mjs"
    },
    "./readiness": {
      "types": "./types/index.d.ts",
      "default": "./src/readiness.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "templates",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --test test/*.test.mjs && node bin/harnessimo.mjs check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "homepage": "https://atamaniuc.github.io/Harnessimo/",
  "bugs": {
    "url": "https://github.com/atamaniuc/Harnessimo/issues"
  },
  "types": "./types/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
