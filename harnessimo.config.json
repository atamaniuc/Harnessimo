{
  "$schema": "./schema/harnessimo.config.schema.json",
  "$comment": "This repository runs the harness on itself. Every check it offers is enforced here, because a standard whose own repository does not meet it is a suggestion.",
  "docs": {
    "roots": [
      ".",
      "docs",
      "specs",
      ".harness"
    ],
    "skip": [
      "node_modules",
      ".git",
      "templates",
      "dist"
    ],
    "mustCarryProof": [
      "README.md",
      "docs/STANDARD.md",
      "docs/ADOPTING.md"
    ],
    "commands": {
      "npm run": "package.json"
    }
  },
  "tracks": {
    "file": "specs/TRACKS.md",
    "log": "specs/TRACKS-LOG.md",
    "specsDir": "specs",
    "taskFile": "tasks.md",
    "gateTasks": true
  },
  "queue": {
    "file": ".harness/4-state/feature_list.json",
    "timeoutMinutes": 10
  },
  "locked": {
    "paths": [
      ".github/workflows/",
      ".harness/1-instructions/CONSTRAINTS.md"
    ],
    "baseline": ".harness/3-environment/locked-baseline",
    "agentTrailer": "Co-Authored-By: Claude"
  },
  "coldStart": {
    "requiredFiles": [
      "AGENTS.md",
      "README.md",
      "harnessimo.config.json",
      ".harness/README.md",
      "specs/TRACKS.md"
    ],
    "entryDocs": [
      "AGENTS.md",
      "README.md"
    ],
    "commands": [
      "npm test",
      "node src/cli.ts check"
    ]
  },
  "cleanExit": {
    "$comment": "console.log is deliberately not a marker here: this is a command-line tool and its output is the product. A project picks the markers that mean 'unfinished' in its own code.",
    "scan": [
      "src",
      "test",
      "scripts"
    ],
    "markers": [
      "TODO",
      "FIXME",
      "XXX",
      "HACK",
      "debugger",
      ".only(",
      ".skip("
    ],
    "allow": [
      "test/cleanexit.test.ts",
      "src/cleanexit.ts"
    ],
    "progressFile": ".harness/4-state/PROGRESS.md",
    "codePrefixes": [
      "src/",
      "test/",
      "scripts/"
    ]
  },
  "instructions": {
    "limits": {
      "AGENTS.md": 120,
      ".harness/1-instructions/CONSTRAINTS.md": 90
    }
  },
  "release": {
    "$comment": "This repository published three versions to npm through a manual workflow run while its own tags stopped at v0.4.1. The check exists because of that, and it is on here first.",
    "manifest": "package.json",
    "changelog": "CHANGELOG.md",
    "tagPrefix": "v"
  },
  "tokens": {
    "$comment": "Spec 0004. On here because this repository is held to its own rules, and because a guard nobody runs against real work is a guard nobody has tested. The state is per-session and gitignored: it describes one run, not the repository.",
    "windowMinutes": 20,
    "statePath": ".harness/3-environment/.reads.json"
  }
}
